# N8N Environment Configuration
# Copy this file to .env and fill in your values

# ============================================================================
# N8N Authentication
# ============================================================================
N8N_PASSWORD=YourSecurePassword123!
# IMPORTANT: Change this to a strong password for production

# ============================================================================
# N8N Server Configuration
# ============================================================================
N8N_HOST=localhost
# For production, use your domain: n8n.yourdomain.com

N8N_PROTOCOL=http
# For production with SSL: https

N8N_WEBHOOK_URL=http://localhost:5678/
# For production: https://n8n.yourdomain.com/

# ============================================================================
# N8N Security
# ============================================================================
N8N_ENCRYPTION_KEY=change-this-to-a-random-32-char-key
# Generate with: openssl rand -base64 32

# ============================================================================
# Regional Settings
# ============================================================================
TIMEZONE=America/Los_Angeles
# Options: America/New_York, Europe/London, Asia/Tokyo, etc.

# ============================================================================
# N8N Performance & Logging
# ============================================================================
N8N_LOG_LEVEL=info
# Options: error, warn, info, verbose, debug

N8N_EXECUTION_TIMEOUT=3600
# Max execution time in seconds (3600 = 1 hour)

N8N_EXECUTIONS_MAX_AGE=168
# Keep execution logs for X hours (168 = 7 days)

# ============================================================================
# PostgreSQL Configuration (Optional - for production)
# ============================================================================
# POSTGRES_PASSWORD=REDACTED
# Generate with: openssl rand -base64 32

# ============================================================================
# Owner Contact Info (for n8n workflows)
# ============================================================================
OWNER_EMAIL=your-email@example.com
OWNER_EMAIL_SENDER=alerts@callflowai.com
OWNER_TELEGRAM_CHAT_ID=your-telegram-chat-id
# Get your Telegram chat ID: https://t.me/userinfobot

# ============================================================================
# External Service URLs (for n8n workflows)
# ============================================================================
BACKEND_API_URL=http://backend:8000/api/v1
# For production: https://api.yourdomain.com/api/v1

FRONTEND_URL=http://localhost:3000
# For production: https://yourdomain.com
