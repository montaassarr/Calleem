# Template for backend secrets
# In production, use AWS Secrets Manager or kubectl create secret
# kubectl create secret generic backend-secrets --from-env-file=.env -n callflow

apiVersion: v1
kind: Secret
metadata:
  name: backend-secrets
  namespace: callflow
type: Opaque
stringData:
  # MongoDB
  MONGO_URI: "mongodb+srv://REDACTED:REDACTED@cluster.mongodb.net/ai_receptionist"
  MONGO_DB_NAME: "ai_receptionist"
  
  # JWT
  SECRET_KEY: "REDACTED"
  ALGORITHM: "HS256"
  ACCESS_TOKEN_EXPIRE_MINUTES: "1440"
  
  # Vapi
  VAPI_PRIVATE_API_KEY: "your-vapi-key"
  VAPI_PUBLIC_KEY: "your-vapi-public-key"
  VAPI_WEBHOOK_URL: "https://your-domain.com/api/v1/vapi/webhook"
  
  # Application
  BACKEND_URL: "https://your-domain.com"
  FRONTEND_URL: "https://your-domain.com"
