# ── Python bytecode ──────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ── Virtual environments ─────────────────────────────────────────────────────
venv/
.venv/
ENV/
env/
.eggs/
*.egg-info/
*.egg

# ── Tests (not needed in production image) ───────────────────────────────────
tests/
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
junit*.xml

# ── IDE ───────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Secrets / local env (never bake credentials into the image) ───────────────
.env
.env.local
.env.*.local
*.pem
*.key
*.crt

# ── Git ───────────────────────────────────────────────────────────────────────
.git/
.gitignore
.gitattributes

# ── Docker (no need to COPY these into themselves) ────────────────────────────
Dockerfile*
docker-compose*.yml
.dockerignore

# ── Documentation ─────────────────────────────────────────────────────────────
*.md
docs/
architecture-plan/

# ── OS artifacts ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
