# ============================================================================
# AI RECEPTIONIST - ENVIRONMENT VARIABLES EXAMPLE
# ============================================================================
# Copy this file to .env and fill in your actual values
# Never commit .env to version control!

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=ai_barber_receptionist

# For MongoDB Atlas (cloud):
# MONGO_URI=mongodb+srv://REDACTED:REDACTED@cluster.mongodb.net/?retryWrites=true&w=majority

# ============================================================================
# TWILIO CONFIGURATION (https://console.twilio.com/)
# ============================================================================
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=REDACTED
TWILIO_PHONE_NUMBER=+1234567890
# Optional: For SMS verification
TWILIO_VERIFY_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================================
# GROQ API CONFIGURATION (https://console.groq.com/)
# ============================================================================
GROQ_API_KEY=REDACTED
GROQ_MODEL=mixtral-8x7b-32768
# Alternative models: llama2-70b-4096, gemma-7b-it

# ============================================================================
# JWT & SECURITY
# ============================================================================
SECRET_KEY=REDACTED
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
APP_NAME=Royal Fade Barbershop AI Receptionist
DEBUG=True
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# CORS Settings (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ============================================================================
# BUSINESS DETAILS
# ============================================================================
BUSINESS_NAME=Royal Fade Barbershop
BUSINESS_PHONE=+1234567890
BUSINESS_EMAIL=info@royalfade.com
BUSINESS_ADDRESS=123 Main Street, City, State 12345
BUSINESS_HOURS=Monday-Saturday 9:00 AM - 8:00 PM, Sunday Closed
TIMEZONE=America/New_York

# Services (comma-separated)
AVAILABLE_SERVICES=Haircut,Beard Trim,Fade,Hot Shave,Hair & Beard Combo

# Default appointment duration in minutes
DEFAULT_APPOINTMENT_DURATION=30

# ============================================================================
# REDIS (Optional - for caching and background tasks)
# ============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ============================================================================
# CELERY (Optional - for background tasks)
# ============================================================================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
