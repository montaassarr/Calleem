# Environment configuration for AI Receptionist Backend

# Application
APP_NAME="AI Receptionist"
ENVIRONMENT="development"
DEBUG=true
API_V1_PREFIX="/api/v1"

# Database
MONGO_URI="mongodb://localhost:27017/calleem"
MONGO_DB_NAME="calleem"

# Security
SECRET_KEY="REDACTED"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Vapi Configuration (safe placeholders only)
VAPI_PRIVATE_API_KEY=
REDACTED
VAPI_WEBHOOK_BEARER_TOKEN=
REDACTED
VAPI_WEBHOOK_URL=
VAPI_ORGANIZATION_ID=
VAPI_ALLOW_UNSIGNED_WEBHOOKS=false
AGENT_INTERNAL_TOKEN=REDACTED

# Dashboard
ALLOW_SELF_REGISTRATION=true
MAX_DASHBOARD_USERS=10

# CORS
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Encryption
MASTER_KEY=

# Gemini (landing-page chat widget) — generate at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Twilio Configuration - SMS & WhatsApp (optional)
# Get these from your Twilio account: https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
REDACTED
TWILIO_PHONE_NUMBER=+1234567890