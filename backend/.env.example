# ─────────────────────────────────────────────────────────────────────────────
# AI Receptionist — Backend Environment Template
# Copy to .env and fill in real values. Never commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME="Calleem"
# Production values. Override to "development" + DEBUG=true for local dev only.
ENVIRONMENT="production"
DEBUG=false
API_V1_PREFIX="/api/v1"

# ── Database ─────────────────────────────────────────────────────────────────
# Include credentials if MongoDB has auth enabled (required in production).
# Example: mongodb://REDACTED:REDACTED@host:27017/calleem?authSource=admin
MONGO_URI="mongodb://localhost:27017/calleem"
MONGO_DB_NAME="calleem"

# ── Security ─────────────────────────────────────────────────────────────────
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=""

ALGORITHM="HS256"
# 30 minutes is the safe default. Do not increase above 60 for production.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AES-256 master key for encrypting stored API keys.
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
MASTER_KEY=""

# Internal service-to-service auth token.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# MUST be set to a strong value in production — startup will refuse to start otherwise.
AGENT_INTERNAL_TOKEN=""

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,https://calleem.tech,https://www.calleem.tech"

# ── Dashboard ────────────────────────────────────────────────────────────────
ALLOW_SELF_REGISTRATION=false
MAX_DASHBOARD_USERS=5

# ── Backend public URL (used to construct webhook URLs) ──────────────────────
BACKEND_URL=""

# ── Vapi Configuration ───────────────────────────────────────────────────────
# Obtain from https://app.vapi.ai → Settings → API Keys
VAPI_PRIVATE_API_KEY=""
VAPI_PUBLIC_KEY=""
VAPI_WEBHOOK_BEARER_TOKEN=""
VAPI_SERVER_CREDENTIAL_ID=""
VAPI_WEBHOOK_URL=""
VAPI_ORGANIZATION_ID=""
VAPI_ALLOW_UNSIGNED_WEBHOOKS=false

# ── Twilio ────────────────────────────────────────────────────────────────────
# Obtain from https://console.twilio.com
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_MESSAGING_SERVICE_SID=""
TWILIO_PHONE_NUMBER=""

# ── Gemini (landing-page chat widget) ────────────────────────────────────────
# Generate at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""
