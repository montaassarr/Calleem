# ─────────────────────────────────────────────────────────────────────────────
# AI Receptionist — Backend Environment Template
# Copy to .env and fill in real values. Never commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME="Calleem"
# Production values. Override to "development" + DEBUG=true for local dev only.
ENVIRONMENT="production"
DEBUG=false
API_V1_PREFIX="/api/v1"

# ── Database ─────────────────────────────────────────────────────────────────
# Include credentials if MongoDB has auth enabled (required in production).
# Example: mongodb://REDACTED:REDACTED@host:27017/calleem?authSource=admin
MONGO_URI="mongodb://localhost:27017/calleem"
MONGO_DB_NAME="calleem"

# ── Security ─────────────────────────────────────────────────────────────────
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=""

ALGORITHM="HS256"
# 30 minutes is the safe default. Do not increase above 60 for production.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AES-256 master key for encrypting stored API keys.
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
MASTER_KEY=""

# Internal service-to-service auth token.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# MUST be set to a strong value in production — startup will refuse to start otherwise.
AGENT_INTERNAL_TOKEN=""

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,https://calleem.tech,https://www.calleem.tech"

# ── Dashboard ────────────────────────────────────────────────────────────────
ALLOW_SELF_REGISTRATION=false
MAX_DASHBOARD_USERS=5

# ── Backend public URL (used to construct webhook URLs) ──────────────────────
BACKEND_URL=""

# ── Vapi Configuration ───────────────────────────────────────────────────────
# Obtain from https://app.vapi.ai → Settings → API Keys
VAPI_PRIVATE_API_KEY=""
VAPI_PUBLIC_KEY=""
VAPI_WEBHOOK_BEARER_TOKEN=""
VAPI_SERVER_CREDENTIAL_ID=""
VAPI_WEBHOOK_URL=""
VAPI_ORGANIZATION_ID=""
VAPI_ALLOW_UNSIGNED_WEBHOOKS=false

# ── Tunisian Arabic (Derja) voice stack ──────────────────────────────────────
# All optional; defaults: Azure ar-TN speech-to-text, GPT-4o, Azure Reem/Hedi voices.
# See backend/services/voice_languages.py. Compare stacks with scripts/tunisian_voice_lab.py.
# Speech-to-text: azure | deepgram | soniox | 11labs
TN_TRANSCRIBER=""
# LLM as provider:model, e.g. openai:gpt-4o, google:gemini-3.5-flash, anthropic:claude-haiku-5-5
TN_LLM=""
# Cloned Tunisian voices on ElevenLabs, "voiceId:Name:gender,voiceId:Name:gender".
# The first one becomes the default Tunisian voice. Add your ElevenLabs API key in Vapi first.
TN_ELEVENLABS_VOICES=""
# eleven_turbo_v2_5 (default) | eleven_v4_turbo | eleven_flash_v2_5
TN_ELEVENLABS_MODEL=""

# ── Twilio ────────────────────────────────────────────────────────────────────
# Obtain from https://console.twilio.com
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_MESSAGING_SERVICE_SID=""
TWILIO_PHONE_NUMBER=""

# ── Gemini (landing-page chat widget) ────────────────────────────────────────
# Generate at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# ── Stripe (card payments) ───────────────────────────────────────────────────
# Keep STRIPE_MOCK_MODE=true until keys exist: clients then see "Request this plan".
# sk_test_... + test webhook secret to test with card 4242 4242 4242 4242; sk_live_... to go live.
# Webhook endpoint: <BACKEND_URL>/api/v1/billing/webhook
STRIPE_MOCK_MODE=true
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ── WhatsApp Cloud API (Meta) ────────────────────────────────────────────────
# Calleem's Meta app: callback URL <BACKEND_URL>/api/v1/whatsapp/webhook with this verify token.
# Generate the verify token: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
WHATSAPP_VERIFY_TOKEN=""
# Meta app → App settings → Basic → App secret (checks that webhooks really come from Meta).
WHATSAPP_APP_SECRET=""
# Optional: system-user token of Calleem's app, used for numbers Calleem manages.
# Businesses with their own Meta app paste their own token in the dashboard instead.
WHATSAPP_TOKEN=""
