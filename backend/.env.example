# ============================================================================
# AI RECEPTIONIST - ENVIRONMENT VARIABLES EXAMPLE
# ============================================================================
# Copy this file to .env and fill in your actual values
# Never commit .env to version control!

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=ai_barber_receptionist

# For MongoDB Atlas (cloud):
# MONGO_URI=mongodb+srv://REDACTED:REDACTED@cluster.mongodb.net/?retryWrites=true&w=majority

# ============================================================================
# WHATSAPP CLOUD API CONFIGURATION
# ============================================================================
# Get your credentials from: https://developers.facebook.com/apps/
# 1. Create a Meta Developer account
# 2. Create a new app and enable WhatsApp Business API
# 3. Copy your access token, phone number ID, and create a verify token
WHATSAPP_TOKEN=REDACTED
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_VERIFY_TOKEN=your_custom_verify_token_here

# ============================================================================
# GROQ API CONFIGURATION (https://console.groq.com/)
# ============================================================================
GROQ_API_KEY=REDACTED
GROQ_MODEL=llama-3.3-70b-versatile
# Alternative models: llama-3.1-70b-versatile, gemma2-9b-it

# ============================================================================
# JWT & SECURITY
# ============================================================================
SECRET_KEY=REDACTED
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
APP_NAME=Royal Fade Barbershop AI Receptionist
DEBUG=True
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# CORS Settings (JSON array format)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# ============================================================================
# BUSINESS DETAILS
# ============================================================================
BUSINESS_NAME=Royal Fade Barbershop
BUSINESS_PHONE=+1234567890
BUSINESS_EMAIL=info@royalfade.com
BUSINESS_ADDRESS=123 Main Street, City, State 12345
BUSINESS_HOURS=Monday-Saturday 9:00 AM - 8:00 PM, Sunday Closed
TIMEZONE=America/New_York

# Services (comma-separated)
AVAILABLE_SERVICES=Haircut,Beard Trim,Fade,Hot Shave,Hair & Beard Combo

# Default appointment duration in minutes
DEFAULT_APPOINTMENT_DURATION=30

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
