# ============================================================================
# AI RECEPTIONIST - ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to .env and fill in your actual values
# Never commit .env to version control!

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=SecurePassword123ChangeThis
MONGO_DB_NAME=ai_receptionist
MONGO_PORT=27017

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
ENVIRONMENT=production
DEBUG=False
SECRET_KEY=REDACTED

# ============================================================================
# API KEYS - AI SERVICES
# ============================================================================
# Groq API (https://console.groq.com/)
GROQ_API_KEY=REDACTED
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI API (https://platform.openai.com/)
OPENAI_API_KEY=REDACTED

# VAPI API (https://vapi.ai/)
VAPI_API_KEY=REDACTED

# ============================================================================
# WHATSAPP CLOUD API
# ============================================================================
# Get credentials from: https://developers.facebook.com/apps/
WHATSAPP_TOKEN=REDACTED
WHATSAPP_PHONE_NUMBER_ID=xxxxxxxxxxxxxxxxxxxxx
WHATSAPP_VERIFY_TOKEN=your-custom-verify-token

# ============================================================================
# BUSINESS CONFIGURATION
# ============================================================================
BUSINESS_NAME=Royal Fade Barbershop
BUSINESS_EMAIL=info@royalfade.com
BUSINESS_PHONE=+1234567890
BUSINESS_ADDRESS=123 Main Street, City, State 12345
BUSINESS_HOURS=Monday-Saturday 9:00 AM - 8:00 PM, Sunday Closed
TIMEZONE=America/New_York

# ============================================================================
# ADMIN ACCOUNT (for initial setup)
# ============================================================================
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8000/api/v1

# ============================================================================
# BACKEND CONFIGURATION
# ============================================================================
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:80"]

# ============================================================================
# TRAEFIK / GATEWAY (Production only)
# ============================================================================
# Uncomment and configure for production deployment with custom domain
# DOMAIN=yourdomain.com
# ACME_EMAIL=admin@yourdomain.com

# ============================================================================
# OPTIONAL SERVICES
# ============================================================================
# Twilio (if using Twilio instead of WhatsApp)
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=REDACTED
# TWILIO_PHONE_NUMBER=+1234567890
