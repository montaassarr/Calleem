{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/payment/layout,_N_T_/payment/mock-checkout/layout,_N_T_/payment/mock-checkout/page,_N_T_/payment/mock-checkout"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/payment/mock-checkout/__PAGE__",
    "/payment/mock-checkout",
    "/payment",
    "/_index",
    "/_head"
  ]
}