# ─────────────────────────────────────────────────────────────────────────────
# AI Receptionist — Docker Compose Secrets Template
# Copy to .env (root of repo) and fill in values before running docker compose.
# Never commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── MongoDB authentication ───────────────────────────────────────────────────
# Required — compose will refuse to start without MONGO_ROOT_PASSWORD.
MONGO_ROOT_USER=admin
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MONGO_ROOT_PASSWORD=""
MONGO_DB_NAME=calleem

# ── Backend secrets (passed through to backend container) ────────────────────
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=""
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
MASTER_KEY=""
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_INTERNAL_TOKEN=""

# ── JWT ──────────────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── CORS (comma-separated list of allowed frontend origins) ─────────────────
CORS_ORIGINS=https://calleem.tech,https://www.calleem.tech

# ── Public API URL (used by browser-side code in the frontend) ───────────────
# Set to your production domain. For local dev leave empty.
NEXT_PUBLIC_API_URL=https://calleem.tech

# ── Grafana (only needed with --profile monitoring) ──────────────────────────
GRAFANA_ADMIN_USER=admin
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
GRAFANA_ADMIN_PASSWORD=""
GRAFANA_ROOT_URL=http://localhost:3001
