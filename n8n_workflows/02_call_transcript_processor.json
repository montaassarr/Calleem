{
  "name": "Call Transcript Processor with AI Summary",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "livekit-call-ended",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "livekit-webhook",
      "name": "Vapi Call Ended Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 300],
      "webhookId": "livekit-webhook"
    },
    {
      "parameters": {
        "jsCode": "// Extract and format the full transcript\nconst webhookData = $input.item.json.body;\nconst transcript = webhookData.transcript || [];\n\nlet formattedTranscript = '';\ntranscript.forEach(msg => {\n  const role = msg.role === 'assistant' ? '🤖 AI' : '👤 Customer';\n  formattedTranscript += `${role}: ${msg.text}\\n\\n`;\n});\n\nreturn {\n  tenant_id: webhookData.tenant_id,\n  call_id: webhookData.call_id,\n  customer_phone: webhookData.customer?.number || 'Unknown',\n  duration_seconds: webhookData.duration_seconds || 0,\n  status: webhookData.status,\n  full_transcript: formattedTranscript.trim(),\n  raw_transcript: transcript,\n  timestamp: new Date().toISOString()\n};"
      },
      "id": "extract-transcript",
      "name": "Extract Transcript Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "url": "=http://backend:8000/api/v1/tenants/{{$json.tenant_id}}",
        "authentication": "none",
        "options": {}
      },
      "id": "get-tenant-config",
      "name": "Get Tenant Config",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [680, 300]
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "resource": "chat",
        "operation": "create",
        "model": "gpt-4",
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You are an expert call analyst. Analyze call transcripts and provide structured insights."
            },
            {
              "role": "user",
              "content": "=Analyze this call transcript and provide a structured JSON response:\n\nTranscript:\n{{$node[\"Extract Transcript Data\"].json[\"full_transcript\"]}}\n\nProvide:\n1. summary (2-3 sentences)\n2. sentiment (positive/neutral/negative)\n3. intent (booking/inquiry/complaint/other)\n4. action_items (array of strings)\n5. key_topics (array of strings)\n6. booking_made (boolean)\n7. follow_up_needed (boolean)"
            }
          ]
        },
        "options": {
          "response_format": "json_object"
        }
      },
      "id": "openai-analysis",
      "name": "OpenAI Call Analysis",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1.2,
      "position": [900, 300],
      "credentials": {
        "openAiApi": {
          "id": "={{$node[\"Get Tenant Config\"].json[\"openai_credential_id\"]}}",
          "name": "OpenAI API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Parse OpenAI response and merge with call data\nconst callData = $node[\"Extract Transcript Data\"].item.json;\nconst aiResponse = JSON.parse($input.item.json.choices[0].message.content);\n\nreturn {\n  ...callData,\n  analysis: {\n    summary: aiResponse.summary,\n    sentiment: aiResponse.sentiment,\n    intent: aiResponse.intent,\n    action_items: aiResponse.action_items || [],\n    key_topics: aiResponse.key_topics || [],\n    booking_made: aiResponse.booking_made || false,\n    follow_up_needed: aiResponse.follow_up_needed || false\n  },\n  duration_minutes: Math.ceil(callData.duration_seconds / 60)\n};"
      },
      "id": "merge-data",
      "name": "Merge Analysis with Call Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "operation": "insertOne",
        "collection": "call_logs",
        "fields": "={{JSON.stringify($json)}}",
        "options": {}
      },
      "id": "save-to-mongodb",
      "name": "Save to MongoDB",
      "type": "n8n-nodes-base.mongodb",
      "typeVersion": 1,
      "position": [1340, 200],
      "credentials": {
        "mongoDb": {
          "id": "global-mongodb",
          "name": "MongoDB"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "slack-enabled",
              "leftValue": "={{$node[\"Get Tenant Config\"].json[\"automations\"][\"slack_notifications\"]}}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-slack",
      "name": "Slack Enabled?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1340, 300]
    },
    {
      "parameters": {
        "channel": "={{$node[\"Get Tenant Config\"].json[\"slack_channel\"] || 'call-logs'}}",
        "text": "=📞 *New Call Completed*\n\n*Customer:* {{$node[\"Merge Analysis with Call Data\"].json[\"customer_phone\"]}}\n*Duration:* {{$node[\"Merge Analysis with Call Data\"].json[\"duration_minutes\"]}} minutes\n*Sentiment:* {{$node[\"Merge Analysis with Call Data\"].json[\"analysis\"][\"sentiment\"]}} {{$node[\"Merge Analysis with Call Data\"].json[\"analysis\"][\"sentiment\"] === 'positive' ? '😊' : $node[\"Merge Analysis with Call Data\"].json[\"analysis\"][\"sentiment\"] === 'negative' ? '😞' : '😐'}}\n*Intent:* {{$node[\"Merge Analysis with Call Data\"].json[\"analysis\"][\"intent\"]}}\n\n*Summary:*\n{{$node[\"Merge Analysis with Call Data\"].json[\"analysis\"][\"summary\"]}}\n\n{{$node[\"Merge Analysis with Call Data\"].json[\"analysis\"][\"action_items\"].length > 0 ? '*Action Items:*\\n' + $node[\"Merge Analysis with Call Data\"].json[\"analysis\"][\"action_items\"].map(item => '• ' + item).join('\\n') : ''}}",
        "attachments": [],
        "otherOptions": {}
      },
      "id": "slack-notification",
      "name": "Send Slack Notification",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.1,
      "position": [1560, 250],
      "credentials": {
        "slackApi": {
          "id": "={{$node[\"Get Tenant Config\"].json[\"slack_credential_id\"]}}",
          "name": "Slack API"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "airtable-enabled",
              "leftValue": "={{$node[\"Get Tenant Config\"].json[\"automations\"][\"airtable_logging\"]}}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-airtable",
      "name": "Airtable Enabled?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1340, 400]
    },
    {
      "parameters": {
        "operation": "append",
        "application": "={{$node[\"Get Tenant Config\"].json[\"airtable_base_id\"]}}",
        "table": "Call Logs",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Call ID": "={{$node[\"Merge Analysis with Call Data\"].json[\"call_id\"]}}",
            "Customer Phone": "={{$node[\"Merge Analysis with Call Data\"].json[\"customer_phone\"]}}",
            "Duration (min)": "={{$node[\"Merge Analysis with Call Data\"].json[\"duration_minutes\"]}}",
            "Sentiment": "={{$node[\"Merge Analysis with Call Data\"].json[\"analysis\"][\"sentiment\"]}}",
            "Intent": "={{$node[\"Merge Analysis with Call Data\"].json[\"analysis\"][\"intent\"]}}",
            "Summary": "={{$node[\"Merge Analysis with Call Data\"].json[\"analysis\"][\"summary\"]}}",
            "Booking Made": "={{$node[\"Merge Analysis with Call Data\"].json[\"analysis\"][\"booking_made\"]}}",
            "Follow Up Needed": "={{$node[\"Merge Analysis with Call Data\"].json[\"analysis\"][\"follow_up_needed\"]}}",
            "Key Topics": "={{$node[\"Merge Analysis with Call Data\"].json[\"analysis\"][\"key_topics\"].join(', ')}}",
            "Timestamp": "={{$node[\"Merge Analysis with Call Data\"].json[\"timestamp\"]}}"
          }
        },
        "options": {}
      },
      "id": "airtable-log",
      "name": "Log to Airtable",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2,
      "position": [1560, 400],
      "credentials": {
        "airtableTokenApi": {
          "id": "={{$node[\"Get Tenant Config\"].json[\"airtable_credential_id\"]}}",
          "name": "Airtable Personal Access Token"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": true,\n  \"call_id\": \"{{$node[\"Extract Transcript Data\"].json[\"call_id\"]}}\",\n  \"analysis\": {{JSON.stringify($node[\"Merge Analysis with Call Data\"].json[\"analysis\"])}},\n  \"processed_at\": \"{{$now.toISO()}}\"\n}",
        "options": {}
      },
      "id": "response",
      "name": "Return Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1780, 300]
    }
  ],
