{
  "name": "Appointment Lifecycle - Simple (No MongoDB Required)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "appointment-action",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 300],
      "webhookId": "appointment-webhook-simple"
    },
    {
      "parameters": {
        "url": "=http://localhost:8000/api/v1/tenants/{{$json.body.tenant_id}}",
        "authentication": "none",
        "options": {}
      },
      "id": "get-tenant-config",
      "name": "Get Tenant Config",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [460, 300]
    },
    {
      "parameters": {
        "url": "=http://localhost:8000/api/v1/appointments?tenant_id={{$json.body.tenant_id}}&customer_phone={{$json.body.appointment.customer_phone}}&status=confirmed,completed&limit=5",
        "authentication": "none",
        "options": {}
      },
      "id": "check-customer-history",
      "name": "Check Customer History (API)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [680, 200]
    },
    {
      "parameters": {
        "url": "=http://localhost:8000/api/v1/appointments/check-availability",
        "method": "POST",
        "authentication": "none",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "tenant_id",
              "value": "={{$json.body.tenant_id}}"
            },
            {
              "name": "date",
              "value": "={{$json.body.appointment.date}}"
            },
            {
              "name": "time",
              "value": "={{$json.body.appointment.time}}"
            },
            {
              "name": "duration_minutes",
              "value": "={{$json.body.appointment.duration_minutes || 30}}"
            }
          ]
        },
        "options": {}
      },
      "id": "check-availability",
      "name": "Check Availability (API)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [680, 300]
    },
    {
      "parameters": {
        "jsCode": "const customerHistory = $input.first().json;\nconst availability = $input.last().json;\n\nconst isReturningCustomer = customerHistory && customerHistory.length > 0;\nconst isAvailable = availability && availability.available === true;\n\nreturn {\n  json: {\n    slot_available: isAvailable,\n    is_returning_customer: isReturningCustomer,\n    previous_appointments: customerHistory?.length || 0,\n    last_visit: isReturningCustomer ? customerHistory[0]?.date : null,\n    appointment_data: $node['Webhook Trigger'].json.body.appointment\n  }\n};"
      },
      "id": "analyze-data",
      "name": "Analyze Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{$json.slot_available}}",
              "value2": true
            }
          ]
        }
      },
      "id": "is-available",
      "name": "Is Slot Available?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "url": "=http://localhost:8000/api/v1/appointments",
        "method": "POST",
        "authentication": "none",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "tenant_id",
              "value": "={{$node['Webhook Trigger'].json.body.tenant_id}}"
            },
            {
              "name": "customer_name",
              "value": "={{$node['Webhook Trigger'].json.body.appointment.customer_name}}"
            },
            {
              "name": "customer_phone",
              "value": "={{$node['Webhook Trigger'].json.body.appointment.customer_phone}}"
            },
            {
              "name": "customer_email",
              "value": "={{$node['Webhook Trigger'].json.body.appointment.customer_email}}"
            },
            {
              "name": "date",
              "value": "={{$node['Webhook Trigger'].json.body.appointment.date}}"
            },
            {
              "name": "time",
              "value": "={{$node['Webhook Trigger'].json.body.appointment.time}}"
            },
            {
              "name": "service",
              "value": "={{$node['Webhook Trigger'].json.body.appointment.service}}"
            },
            {
              "name": "notes",
              "value": "={{$node['Webhook Trigger'].json.body.appointment.notes}}"
            },
            {
              "name": "duration_minutes",
              "value": "={{$node['Webhook Trigger'].json.body.appointment.duration_minutes || 30}}"
            },
            {
              "name": "is_returning_customer",
              "value": "={{$json.is_returning_customer}}"
            }
          ]
        },
        "options": {}
      },
      "id": "create-appointment",
      "name": "Create Appointment (API)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1340, 200]
    },
    {
      "parameters": {
        "url": "=http://localhost:8000/api/v1/whatsapp/send",
        "method": "POST",
        "authentication": "none",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "to",
              "value": "={{$node['Webhook Trigger'].json.body.appointment.customer_phone}}"
            },
            {
              "name": "message",
              "value": "={{$json.is_returning_customer ? '🎉 Welcome back! Your appointment is confirmed for ' + $node['Webhook Trigger'].json.body.appointment.date + ' at ' + $node['Webhook Trigger'].json.body.appointment.time + '. This will be visit #' + ($json.previous_appointments + 1) + '!' : '✅ Appointment confirmed for ' + $node['Webhook Trigger'].json.body.appointment.date + ' at ' + $node['Webhook Trigger'].json.body.appointment.time + '. Looking forward to seeing you!'}}"
            }
          ]
        },
        "options": {}
      },
      "id": "send-whatsapp",
      "name": "Send WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1340, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { success: true, message: 'Appointment created', appointment_id: $json.id } }}"
      },
      "id": "success-response",
      "name": "Success Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1560, 250]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { success: false, message: 'Time slot not available', conflicts: $json.conflict_details } }}"
      },
      "id": "conflict-response",
      "name": "Conflict Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1340, 400]
    }
  ],
