{
  "name": "Owner God-Mode: Low Credit Alerts",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 9
            },
            {
              "triggerAtHour": 15
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Check Twice Daily (9AM & 3PM)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "operation": "aggregate",
        "collection": "tenants",
        "query": "=[\n  {\n    \"$match\": {\n      \"plan\": {\"$in\": [\"pro\", \"enterprise\"]},\n      \"status\": \"active\"\n    }\n  },\n  {\n    \"$addFields\": {\n      \"credits_remaining_pct\": {\n        \"$cond\": [\n          {\"$gt\": [\"$credits_total\", 0]},\n          {\"$multiply\": [\n            {\"$divide\": [\"$credits_remaining\", \"$credits_total\"]},\n            100\n          ]},\n          0\n        ]\n      }\n    }\n  },\n  {\n    \"$match\": {\n      \"$or\": [\n        {\"credits_remaining_pct\": {\"$lt\": 10}},\n        {\"credits_remaining\": {\"$lt\": 50}}\n      ]\n    }\n  }\n]",
        "options": {}
      },
      "id": "find-low-credit",
      "name": "Find Low Credit Tenants",
      "type": "n8n-nodes-base.mongodb",
      "typeVersion": 1,
      "position": [460, 300],
      "credentials": {
        "mongoDb": {
          "id": "global-mongodb",
          "name": "MongoDB"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "has-results",
              "leftValue": "={{$json.length}}",
              "rightValue": "0",
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-has-alerts",
      "name": "Any Low Credit Tenants?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "jsCode": "// Format alert data\nconst tenants = $input.all();\nconst criticalAlerts = [];\nconst warningAlerts = [];\n\ntenants.forEach(item => {\n  const tenant = item.json;\n  const alert = {\n    name: tenant.business_name || tenant.name || 'Unknown',\n    email: tenant.email || 'No email',\n    plan: tenant.plan,\n    credits_remaining: Math.round(tenant.credits_remaining || 0),\n    credits_total: tenant.credits_total || 0,\n    credits_pct: Math.round(tenant.credits_remaining_pct || 0),\n    last_payment: tenant.last_payment_date || 'Never',\n    tenant_id: tenant._id\n  };\n  \n  if (alert.credits_pct < 5 || alert.credits_remaining < 20) {\n    criticalAlerts.push(alert);\n  } else {\n    warningAlerts.push(alert);\n  }\n});\n\nreturn {\n  total_alerts: tenants.length,\n  critical_count: criticalAlerts.length,\n  warning_count: warningAlerts.length,\n  critical: criticalAlerts,\n  warnings: warningAlerts,\n  timestamp: new Date().toISOString()\n};"
      },
      "id": "format-alerts",
      "name": "Format Alert Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 250]
    },
    {
      "parameters": {
        "chatId": "={{$env.OWNER_TELEGRAM_CHAT_ID}}",
        "text": "=🚨 *CallFlow AI - Low Credit Alert*\n\n📊 *Summary:*\nCritical: {{$json.critical_count}}\nWarnings: {{$json.warning_count}}\n\n{{$json.critical_count > 0 ? '❗ *CRITICAL (< 5% or < $20):*\\n' + $json.critical.map(t => `• ${t.name} (${t.plan})\\n  Credits: $${t.credits_remaining} (${t.credits_pct}%)\\n  Email: ${t.email}\\n  Last Payment: ${t.last_payment}`).join('\\n\\n') : ''}}\n\n{{$json.warning_count > 0 ? '⚠️ *WARNINGS (< 10%):*\\n' + $json.warnings.map(t => `• ${t.name} (${t.plan})\\n  Credits: $${t.credits_remaining} (${t.credits_pct}%)\\n  Email: ${t.email}`).join('\\n\\n') : ''}}\n\n🔗 _Action: Follow up with clients to avoid service interruption_",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "telegram-alert",
      "name": "Send Telegram Alert to Owner",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [1120, 200],
      "credentials": {
        "telegramApi": {
          "id": "owner-telegram",
          "name": "Telegram Bot API"
        }
      }
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "={{$env.OWNER_EMAIL}}",
          "mode": "name"
        },
        "messageType": "block",
        "blocksUi": {
          "blocksValues": [
            {
              "type": "section",
              "textType": "mrkdwn",
              "text": "=*🚨 Low Credit Alert - CallFlow AI*\n\n{{$node[\"Format Alert Data\"].json.critical_count}} critical, {{$node[\"Format Alert Data\"].json.warning_count}} warnings"
            },
            {
              "type": "divider"
            },
            {
              "type": "section",
              "textType": "mrkdwn",
              "text": "={{$node[\"Format Alert Data\"].json.critical.map(t => `:red_circle: *${t.name}* (${t.plan})\\nCredits: $${t.credits_remaining} (${t.credits_pct}%)\\nEmail: ${t.email}`).join('\\n\\n')}}"
            }
          ]
        }
      },
      "id": "slack-alert",
      "name": "Send Slack Alert (Optional)",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.1,
      "position": [1120, 300],
      "disabled": true,
      "credentials": {
        "slackOAuth2Api": {
          "id": "owner-slack",
          "name": "Slack OAuth2 API"
        }
      }
    },
    {
      "parameters": {
        "fromEmail": "={{$env.OWNER_EMAIL_SENDER || 'alerts@callflowai.com'}}",
        "toEmail": "={{$env.OWNER_EMAIL}}",
        "subject": "=🚨 Low Credit Alert: {{$node[\"Format Alert Data\"].json.critical_count}} Critical",
        "emailType": "html",
        "message": "=<!DOCTYPE html>\n<html>\n<head>\n  <style>\n    body { font-family: Arial, sans-serif; line-height: 1.6; color: #333; }\n    .container { max-width: 600px; margin: 0 auto; padding: 20px; }\n    .header { background: #dc2626; color: white; padding: 20px; border-radius: 8px 8px 0 0; }\n    .content { background: #f9fafb; padding: 20px; border-radius: 0 0 8px 8px; }\n    .alert-critical { background: #fee2e2; border-left: 4px solid #dc2626; padding: 15px; margin: 10px 0; }\n    .alert-warning { background: #fef3c7; border-left: 4px solid #f59e0b; padding: 15px; margin: 10px 0; }\n    .stats { display: flex; gap: 20px; margin: 20px 0; }\n    .stat-box { flex: 1; background: white; padding: 15px; border-radius: 8px; text-align: center; }\n  </style>\n</head>\n<body>\n  <div class=\"container\">\n    <div class=\"header\">\n      <h1>🚨 Low Credit Alert</h1>\n      <p>CallFlow AI - Owner Dashboard</p>\n    </div>\n    <div class=\"content\">\n      <div class=\"stats\">\n        <div class=\"stat-box\">\n          <h2>{{$node[\"Format Alert Data\"].json.critical_count}}</h2>\n          <p>Critical</p>\n        </div>\n        <div class=\"stat-box\">\n          <h2>{{$node[\"Format Alert Data\"].json.warning_count}}</h2>\n          <p>Warnings</p>\n        </div>\n      </div>\n      \n      <h3>❗ Critical Alerts (< 5% or < $20)</h3>\n      {{$node[\"Format Alert Data\"].json.critical.map(t => `\n        <div class=\"alert-critical\">\n          <strong>${t.name}</strong> (${t.plan})<br>\n          Credits: $${t.credits_remaining} (${t.credits_pct}%)<br>\n          Email: ${t.email}<br>\n          Last Payment: ${t.last_payment}\n        </div>\n      `).join('')}}\n      \n      <h3>⚠️ Warnings (< 10%)</h3>\n      {{$node[\"Format Alert Data\"].json.warnings.map(t => `\n        <div class=\"alert-warning\">\n          <strong>${t.name}</strong> (${t.plan})<br>\n          Credits: $${t.credits_remaining} (${t.credits_pct}%)<br>\n          Email: ${t.email}\n        </div>\n      `).join('')}}\n      \n      <p style=\"margin-top: 30px; padding-top: 20px; border-top: 1px solid #ddd;\">\n        <strong>Recommended Actions:</strong><br>\n        1. Contact clients to top up credits<br>\n        2. Review usage patterns<br>\n        3. Consider offering credit bundles\n      </p>\n    </div>\n  </div>\n</body>\n</html>",
        "options": {}
      },
      "id": "email-alert",
      "name": "Send Email Report",
      "type": "n8n-nodes-base.emailSend",
