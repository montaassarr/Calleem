{
  "name": "AI Receptionist Production",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ai-receptionist/chat",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-chat",
      "name": "Chat Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [240, 300],
      "webhookId": "ai-chat-production"
    },
    {
      "parameters": {
        "url": "=https://nonsustainable-delaine-grabbable.ngrok-free.dev/api/v1/voice-agent/tenant-config/{{ $json.body.tenant_id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "X-Tenant-ID", "value": "={{ $json.body.tenant_id }}"},
            {"name": "ngrok-skip-browser-warning", "value": "true"}
          ]
        },
        "options": {"timeout": 10000}
      },
      "id": "get-business-config",
      "name": "Get Business Config",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [480, 300]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $('Chat Webhook').item.json.body.message }}",
        "options": {
          "systemMessage": "=You are {{ $json.ai_name || 'Parker' }}, the {{ $json.ai_personality || 'friendly and professional' }} virtual receptionist at **{{ $json.business_name || $('Chat Webhook').item.json.body.business_name }}**.\n\n## BUSINESS INFO\n- **Type**: {{ $json.business_type || 'Service Business' }}\n- **Location**: {{ $json.location || 'Our location' }}\n- **Hours**: {{ $json.working_hours || 'Mon-Fri 9AM-6PM, Sat 10AM-4PM' }}\n- **Services**: {{ $json.services || 'Various services available' }}\n\n## CURRENT TIME\nToday: {{ $now.format('dddd, YYYY-MM-DD') }}\nTime: {{ $now.format('HH:mm') }}\n\n## YOUR ROLE\n{{ $json.ai_role || 'Help customers book appointments and answer questions about our services.' }}\n\n## BOOKING WORKFLOW\n1. Understand what service the customer needs\n2. Check availability for their preferred date/time\n3. Collect: Name, Email, Phone\n4. Confirm and book the appointment\n\n## RULES\n- Keep responses SHORT (2-3 sentences)\n- Be warm and professional\n- Ask ONE question at a time\n- Always confirm before booking\n- Format dates as YYYY-MM-DD\n- Format times as HH:MM (24h)"
        }
      },
      "id": "ai-agent",
      "name": "AI Receptionist",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 2.1,
      "position": [720, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"response\": {{ JSON.stringify($json.output) }}\n}",
        "options": {}
      },
      "id": "respond-success",
      "name": "Respond Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [960, 300]
    },
    {
      "parameters": {
        "model": "llama-3.3-70b-versatile",
        "options": {"temperature": 0.7}
      },
      "id": "groq-model",
      "name": "Groq AI",
      "type": "@n8n/n8n-nodes-langchain.lmChatGroq",
      "typeVersion": 1,
      "position": [520, 520],
      "credentials": {
        "groqApi": {
          "id": "dvToCrquUUPcrotB",
          "name": "Groq account"
        }
      }
    },
    {
      "parameters": {
        "contextWindowLength": 15,
        "sessionIdOption": "customKey",
        "sessionKey": "={{ $('Chat Webhook').item.json.body.session_id }}"
      },
      "id": "memory",
      "name": "Conversation Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.3,
      "position": [640, 520]
    },
    {
      "parameters": {
        "name": "check_availability",
        "description": "Check if a specific date and time slot is available for booking. Returns availability status.",
        "method": "GET",
        "url": "=https://nonsustainable-delaine-grabbable.ngrok-free.dev/api/v1/appointments/agent/availability?date={{ $fromAI('date', 'Date in YYYY-MM-DD format', 'string') }}&time={{ $fromAI('time', 'Time in HH:MM 24-hour format', 'string') }}",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {"name": "X-Tenant-ID", "value": "={{ $('Chat Webhook').item.json.body.tenant_id }}"},
            {"name": "ngrok-skip-browser-warning", "value": "true"}
          ]
        }
      },
      "id": "tool-availability",
      "name": "Check Availability",
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1.1,
      "position": [760, 520]
    },
    {
      "parameters": {
        "name": "book_appointment",
        "description": "Book a new appointment. Requires customer name, email, phone, date, time, and service type.",
        "method": "POST",
        "url": "https://nonsustainable-delaine-grabbable.ngrok-free.dev/api/v1/appointments/agent/book",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {"name": "X-Tenant-ID", "value": "={{ $('Chat Webhook').item.json.body.tenant_id }}"},
            {"name": "Content-Type", "value": "application/json"},
            {"name": "ngrok-skip-browser-warning", "value": "true"}
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"customer_name\": \"{{ $fromAI('customer_name', 'Full name of the customer', 'string') }}\",\n  \"customer_email\": \"{{ $fromAI('customer_email', 'Email address', 'string') }}\",\n  \"customer_phone\": \"{{ $fromAI('customer_phone', 'Phone number', 'string') }}\",\n  \"date\": \"{{ $fromAI('date', 'Appointment date YYYY-MM-DD', 'string') }}\",\n  \"time\": \"{{ $fromAI('time', 'Appointment time HH:MM', 'string') }}\",\n  \"service\": \"{{ $fromAI('service', 'Type of service', 'string') }}\"\n}"
      },
      "id": "tool-book",
      "name": "Book Appointment",
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1.1,
      "position": [880, 520]
    },
    {
      "parameters": {
        "name": "cancel_appointment",
        "description": "Cancel an existing appointment by customer email and date.",
        "method": "POST",
        "url": "https://nonsustainable-delaine-grabbable.ngrok-free.dev/api/v1/appointments/agent/cancel",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {"name": "X-Tenant-ID", "value": "={{ $('Chat Webhook').item.json.body.tenant_id }}"},
            {"name": "Content-Type", "value": "application/json"},
            {"name": "ngrok-skip-browser-warning", "value": "true"}
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"customer_email\": \"{{ $fromAI('customer_email', 'Customer email', 'string') }}\",\n  \"date\": \"{{ $fromAI('date', 'Appointment date YYYY-MM-DD', 'string') }}\"\n}"
      },
      "id": "tool-cancel",
      "name": "Cancel Appointment",
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1.1,
      "position": [1000, 520]
    }
  ],
  "connections": {
    "Chat Webhook": {
      "main": [[{"node": "Get Business Config", "type": "main", "index": 0}]]
    },
    "Get Business Config": {
      "main": [[{"node": "AI Receptionist", "type": "main", "index": 0}]]
    },
    "AI Receptionist": {
      "main": [[{"node": "Respond Success", "type": "main", "index": 0}]]
    },
    "Groq AI": {
      "ai_languageModel": [[{"node": "AI Receptionist", "type": "ai_languageModel", "index": 0}]]
    },
    "Conversation Memory": {
      "ai_memory": [[{"node": "AI Receptionist", "type": "ai_memory", "index": 0}]]
    },
    "Check Availability": {
      "ai_tool": [[{"node": "AI Receptionist", "type": "ai_tool", "index": 0}]]
    },
    "Book Appointment": {
      "ai_tool": [[{"node": "AI Receptionist", "type": "ai_tool", "index": 0}]]
    },
    "Cancel Appointment": {
      "ai_tool": [[{"node": "AI Receptionist", "type": "ai_tool", "index": 0}]]
    }
  },
  "settings": {"executionOrder": "v1"},
  "tags": ["production", "ai", "receptionist"]
}
