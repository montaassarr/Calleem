{
  "name": "Appointment Lifecycle Automation",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "appointment-action",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 300],
      "webhookId": "appointment-webhook"
    },
    {
      "parameters": {
        "url": "=http://backend:8000/api/v1/tenants/{{$json.body.tenant_id}}",
        "authentication": "none",
        "options": {}
      },
      "id": "get-tenant-config",
      "name": "Get Tenant Config",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [460, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "create-action",
              "leftValue": "={{$node[\"Webhook Trigger\"].json[\"body\"][\"action\"]}}",
              "rightValue": "create",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "is-create",
      "name": "Is Create Action",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "google-enabled",
              "leftValue": "={{$node[\"Get Tenant Config\"].json[\"automations\"][\"google_calendar_sync\"]}}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-google-enabled",
      "name": "Google Calendar Enabled?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [900, 200]
    },
    {
      "parameters": {
        "calendar": "primary",
        "start": "={{$node[\"Webhook Trigger\"].json[\"body\"][\"appointment\"][\"datetime\"]}}",
        "end": "={{DateTime.fromISO($node[\"Webhook Trigger\"].json[\"body\"][\"appointment\"][\"datetime\"]).plus({minutes: parseInt($node[\"Webhook Trigger\"].json[\"body\"][\"appointment\"][\"duration_minutes\"])}).toISO()}}",
        "title": "={{$node[\"Webhook Trigger\"].json[\"body\"][\"appointment\"][\"service\"]}} - {{$node[\"Webhook Trigger\"].json[\"body\"][\"appointment\"][\"client_name\"]}}",
        "description": "Phone: {{$node[\"Webhook Trigger\"].json[\"body\"][\"appointment\"][\"client_phone\"]}}\n\nNotes: {{$node[\"Webhook Trigger\"].json[\"body\"][\"appointment\"][\"notes\"] || 'No notes'}}"
      },
      "id": "google-calendar",
      "name": "Add to Google Calendar",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 2,
      "position": [1120, 120],
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "{{$node[\"Get Tenant Config\"].json[\"google_credential_id\"]}}",
          "name": "Google Calendar OAuth2 account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "whatsapp-enabled",
              "leftValue": "={{$node[\"Get Tenant Config\"].json[\"automations\"][\"whatsapp_confirmations\"]}}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-whatsapp",
      "name": "WhatsApp Enabled?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v18.0/{{$node[\"Get Tenant Config\"].json[\"whatsapp_phone_number_id\"]}}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{$node[\"Get Tenant Config\"].json[\"whatsapp_token\"]}}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"{{$node[\"Webhook Trigger\"].json[\"body\"][\"appointment\"][\"client_phone\"].replace(/[^0-9]/g, '')}}\",\n  \"type\": \"text\",\n  \"text\": {\n    \"body\": \"✅ Appointment Confirmed!\\n\\n{{$node[\"Webhook Trigger\"].json[\"body\"][\"appointment\"][\"client_name\"]}}, your appointment is confirmed for:\\n📅 {{DateTime.fromISO($node[\"Webhook Trigger\"].json[\"body\"][\"appointment\"][\"datetime\"]).toFormat('cccc, MMMM d at h:mm a')}}\\n⏱️ Duration: {{$node[\"Webhook Trigger\"].json[\"body\"][\"appointment\"][\"duration_minutes\"]}} minutes\\n\\nLooking forward to seeing you! - {{$node[\"Get Tenant Config\"].json[\"business_name\"]}}\"\n  }\n}",
        "options": {}
      },
      "id": "send-whatsapp",
      "name": "Send WhatsApp Confirmation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "airtable-enabled",
              "leftValue": "={{$node[\"Get Tenant Config\"].json[\"automations\"][\"airtable_logging\"]}}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-airtable",
      "name": "Airtable Enabled?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [900, 400]
    },
    {
      "parameters": {
        "operation": "append",
        "application": "={{$node[\"Get Tenant Config\"].json[\"airtable_base_id\"]}}",
        "table": "Appointments",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Client Name": "={{$node[\"Webhook Trigger\"].json[\"body\"][\"appointment\"][\"client_name\"]}}",
            "Phone": "={{$node[\"Webhook Trigger\"].json[\"body\"][\"appointment\"][\"client_phone\"]}}",
            "Email": "={{$node[\"Webhook Trigger\"].json[\"body\"][\"appointment\"][\"client_email\"] || ''}}",
            "Datetime": "={{$node[\"Webhook Trigger\"].json[\"body\"][\"appointment\"][\"datetime\"]}}",
            "Service": "={{$node[\"Webhook Trigger\"].json[\"body\"][\"appointment\"][\"service\"]}}",
            "Duration": "={{$node[\"Webhook Trigger\"].json[\"body\"][\"appointment\"][\"duration_minutes\"]}}",
            "Status": "Confirmed",
            "Notes": "={{$node[\"Webhook Trigger\"].json[\"body\"][\"appointment\"][\"notes\"] || ''}}"
          }
        },
        "options": {}
      },
      "id": "airtable-log",
      "name": "Log to Airtable",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2,
      "position": [1120, 400],
      "credentials": {
        "airtableTokenApi": {
          "id": "={{$node[\"Get Tenant Config\"].json[\"airtable_credential_id\"]}}",
          "name": "Airtable Personal Access Token"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": true,\n  \"message\": \"Appointment processed successfully\",\n  \"actions_taken\": [\n    \"{{$node[\"Google Calendar Enabled?\"].json[\"output\"] === 0 ? 'Google Calendar: Added' : 'Google Calendar: Skipped'}}\",\n    \"{{$node[\"WhatsApp Enabled?\"].json[\"output\"] === 0 ? 'WhatsApp: Sent' : 'WhatsApp: Skipped'}}\",\n    \"{{$node[\"Airtable Enabled?\"].json[\"output\"] === 0 ? 'Airtable: Logged' : 'Airtable: Skipped'}}\"\n  ]\n}",
        "options": {}
      },
      "id": "response",
      "name": "Return Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1340, 300]
    }
  ],
