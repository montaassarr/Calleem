    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Calculate available slots\nconst appointments = $input.item.json.appointments || [];\nconst startTime = new Date($('Extract Data2').item.json.start_time);\nconst endTime = new Date($('Extract Data2').item.json.end_time);\n\nconst SLOT_DURATION = 30 * 60 * 1000; // 30 minutes\nconst WORKDAY_START = 9; // 9 AM\nconst WORKDAY_END = 18; // 6 PM\n\nconst availableSlots = [];\nlet current = new Date(startTime);\ncurrent.setHours(WORKDAY_START, 0, 0, 0);\n\nwhile (current < endTime) {\n  const slotEnd = new Date(current.getTime() + SLOT_DURATION);\n  \n  // Check if slot is within working hours\n  if (current.getHours() >= WORKDAY_START && slotEnd.getHours() <= WORKDAY_END) {\n    // Check if slot conflicts with existing appointments\n    const hasConflict = appointments.some(apt => {\n      const aptStart = new Date(apt.datetime);\n      const aptEnd = new Date(aptStart.getTime() + (apt.duration * 60 * 1000));\n      return (current < aptEnd && slotEnd > aptStart);\n    });\n    \n    if (!hasConflict) {\n      availableSlots.push({\n        start: current.toISOString(),\n        formatted: current.toLocaleString('en-US', {\n          weekday: 'long',\n          month: 'long',\n          day: 'numeric',\n          hour: 'numeric',\n          minute: '2-digit',\n          hour12: true\n        })\n      });\n    }\n  }\n  \n  current = new Date(current.getTime() + SLOT_DURATION);\n}\n\nreturn {\n  json: {\n    availableSlots: availableSlots.map(s => s.formatted).join('\\n')\n  }\n};"
      },
      "id": "9d5d6855-6fcb-41b3-9a1b-e146367042a2",
      "name": "Calculate Available Slots",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -2768,
        -160
      ]
    },
